{
  "name": "gitlab-dashboard",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Personal dashboard of hours logged in GitLab issues and merge requests.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "prebuild": "bun run i18n:compile",
    "build": "bun --bun vite build && bun run csp && bun run sourcemaps:upload && bun run sourcemaps:drop",
    "csp": "bun --bun scripts/write-csp.ts",
    "sourcemaps:upload": "bun --bun scripts/upload-source-maps.ts",
    "sourcemaps:drop": "bun --bun scripts/drop-source-maps.ts",
    "arch:trace": "bun --bun scripts/check-traceability.ts",
    "preview": "bun --bun vite preview",
    "i18n:compile": "bun --bun scripts/compile-messages.ts",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "prelint": "bun run i18n:compile",
    "lint": "bun --bun eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "bun --bun eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "lint:a11y": "bunx --bun biome lint",
    "pretypecheck": "bun run i18n:compile",
    "typecheck": "bun --bun tsc -p tsconfig.json",
    "arch:layers": "bun --bun steiger ./src",
    "arch:graph": "depcruise src netlify",
    "deadcode": "bun --bun knip",
    "types:coverage": "type-coverage",
    "security:audit": "bun audit",
    "size": "bun --bun size-limit",
    "verify": "bun run format:check && bun run lint && bun run lint:a11y && bun run a11y:contrast && bun run i18n:check && bun run typecheck && bun run arch:layers && bun run arch:graph && bun run arch:trace && bun run deadcode && bun run types:coverage && bun run security:audit",
    "pretest": "bun run i18n:compile",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "pretest:coverage": "bun run i18n:compile",
    "test:coverage": "bun --bun vitest run --coverage",
    "pretest:e2e": "bun run i18n:compile",
    "test:e2e": "bun --bun bddgen && playwright test",
    "test:e2e:ui": "bun --bun bddgen && playwright test --ui",
    "test:mutation": "node ./node_modules/@stryker-mutator/core/bin/stryker.js run",
    "prepare": "lefthook install",
    "i18n:check": "bun --bun scripts/check-messages.ts",
    "a11y:contrast": "bun --bun scripts/check-contrast.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@date-fns/tz": "^1.5.0",
    "@daypicker/react": "^10.0.2",
    "@netlify/blobs": "^11.1.0",
    "@sentry/browser": "^11.2.0",
    "@sentry/core": "^11.2.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-table": "^9.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^7.0.0",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@fission-ai/openspec": "^1.10.0",
    "@inlang/paraglide-js": "^2.24.1",
    "@netlify/functions": "^6.0.0",
    "@playwright/test": "^1.62.1",
    "@sentry/cli": "^3.8.0",
    "@size-limit/file": "^13.0.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.34",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "fast-check": "^4.10.2",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "playwright-bdd": "^9.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "size-limit": "^13.0.3",
    "steiger": "^0.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "type-coverage": "^2.30.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.4.0",
  "trustedDependencies": [
    "lefthook",
    "msw"
  ],
  "overrides": {
    "qs": "^6.15.3"
  },
  "typeCoverage": {
    "atLeast": 99,
    "cache": true,
    "detail": true,
    "ignoreFiles": [
      "src/paraglide/**",
      "src/app/routeTree.gen.ts",
      "src/app/router.tsx",
      "src/app/main.tsx"
    ],
    "strict": true
  }
}
