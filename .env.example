# OAuth application Client ID, created at GitLab > User Settings > Applications.
# The application must NOT be confidential (PKCE public client) and needs the
# `read_api` and `openid` scopes — `read_api` to read hours, `openid` so the
# two endpoints can be told who is calling. This value is public and ships in
# the client bundle.
VITE_GITLAB_CLIENT_ID=

# GitLab instance. Defaults to https://gitlab.com when omitted.
VITE_GITLAB_BASE_URL=https://gitlab.com

# Optional. The Sentry project fault reports go to — public by design, like the
# client id. Empty, nothing is reported and the reporting code is not built.
# The source-map upload reads SENTRY_AUTH_TOKEN, SENTRY_ORG and SENTRY_PROJECT,
# which belong in the deploy's build settings, never in this file.
VITE_SENTRY_DSN=
