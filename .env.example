# URL da instância do GitLab (default: https://gitlab.com)
GITLAB_BASE_URL=https://gitlab.com

# Personal Access Token com escopo read_api
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Escopo da busca: configure EXATAMENTE UM dos dois
GITLAB_GROUP_PATH=meu-grupo
# GITLAB_PROJECT_PATH=meu-grupo/meu-projeto

# Fuso usado para agrupar horas por dia (default: America/Sao_Paulo)
GITLAB_TIME_ZONE=America/Sao_Paulo
