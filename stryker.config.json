{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing proves the model tests actually detect broken behaviour rather than merely executing it. Scoped to the pure model layer, where mutants are cheap to run and failures are unambiguous.",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": ["src/**/model/**/*.ts", "!src/**/*.test.ts"],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "break": 85,
    "low": 85,
    "high": 95
  },
  "tempDirName": ".stryker-tmp",
  "plugins": ["@stryker-mutator/vitest-runner"]
}
